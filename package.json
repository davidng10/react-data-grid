{
  "name": "data-griddle-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:lib && concurrently -k \"pnpm --filter data-griddle dev\" \"pnpm --filter @data-griddle/docs dev\"",
    "build:lib": "pnpm --filter data-griddle build",
    "build": "pnpm build:lib && pnpm --filter @data-griddle/docs build",
    "lint:eslint": "eslint .",
    "lint:tsc": "pnpm --filter data-griddle lint && pnpm --filter @data-griddle/docs typecheck && pnpm lint:fixtures",
    "lint": "pnpm lint:eslint && pnpm lint:tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:package": "pnpm build:lib && node scripts/check-package.mjs",
    "check:consumers": "pnpm check:package && node scripts/check-consumers.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "check:docs": "pnpm build && node scripts/check-docs.mjs",
    "lint:fixtures": "tsc -p fixtures/tsconfig.json && tsc -p fixtures/vite/tsconfig.json && tsc -p fixtures/next-app/tsconfig.json && tsc -p fixtures/next-pages/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "esbuild": "0.28.2",
    "@playwright/test": "1.63.0",
    "concurrently": "9.2.1",
    "data-griddle": "workspace:*",
    "next": "16.3.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
